{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.8.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "storage", "activeTab", "downloads", "scripting", "alarms"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["<all_urls>", "https://api.replicate.com/*", "https://generativelanguage.googleapis.com/*"],
  "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.youtube-nocookie.com/*", "*://*.ytimg.com/*"], "js": ["probe.js", "probe-listener.js", "context.js"], "run_at": "document_start", "all_frames": true}],
  "background": {"service_worker": "sw.js"},
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {"48": "icon48.png", "96": "icon96.png"}
  },
  "options_ui": {"page": "popup.html#settings", "open_in_tab": false},
  "icons": {"48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}
}
